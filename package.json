{
  "name": "icloud-hide-my-email-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "iCloud+の「メールを非公開」アドレスをChromeから作成してコピーする拡張機能",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "test:e2e": "npm run build:e2e && node tests/e2e/run.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
